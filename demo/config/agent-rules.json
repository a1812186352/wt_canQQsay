{
  "push_rules": {
    "max_daily_pushes": 5,
    "max_per_contact": 2,
    "check_interval_seconds": 60,
    "toast_duration_seconds": 8,
    "cooldown_after_dismiss_hours": 2
  },
  "self_optimize": {
    "enabled": true,
    "bad_feedback_penalty": {
      "reduce_daily_by": 1,
      "reduce_per_contact_by": 1,
      "multiply_interval_by": 2
    },
    "good_feedback_bonus": {
      "increase_daily_by": 1
    },
    "min_daily": 2,
    "max_interval_ms": 300000
  },
  "push_types": {
    "reply_suggest": {
      "priority": "medium",
      "template": "{name} 给你发了消息，用悬浮球中的智能回复建议来快速回复"
    },
    "reminder": {
      "priority": "medium",
      "template": "你答应过{name}要{action}，别忘了"
    },
    "reconnect": {
      "priority": "low",
      "template": "好久没和{name}聊天了，ta最近对{topic}很感兴趣，要不要发个消息？"
    },
    "topic_suggest": {
      "priority": "low",
      "template": "{name}也喜欢{topic}，你们可以聊聊"
    }
  }
}
